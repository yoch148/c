{
  "name": "kupat-hayomi",
  "version": "1.0.0",
  "description": "קופת היומי",
  "main": "main.js",
  "author": "kupat-hayomi",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --x64 --publish never"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.kupat.hayomi",
    "productName": "KupatHayomi",
    "files": ["main.js", "preload.js", "app/**/*"],
    "win": {
      "target": ["portable", "nsis"],
      "artifactName": "${productName}-${version}-${target}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
